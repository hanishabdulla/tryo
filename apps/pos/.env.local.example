# Deploy URL for the Convex backend, from `npm run convex:dev` at the repo root.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Optional exact system printer names for silent printing. Without these the
# Electron shell falls back to the OS default printer.
ELECTRON_RECEIPT_PRINTER=EML POS-80C
ELECTRON_MENU_PRINTER=EML POS-80C
