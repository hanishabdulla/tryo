{
  "name": "tryo",
  "version": "0.0.0",
  "private": true,
  "description": "Tryo monorepo — takeaway POS, customer site, and the Convex backend they share",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "pos": "npm run dev -w @tryo/pos",
    "pos:electron": "npm run electron:dev -w @tryo/pos",
    "web": "npm run dev -w @tryo/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "dependencies": {
    "convex": "^1.35.1"
  }
}
